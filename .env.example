# ── Tokens personales (opcional) ──
# Copia este archivo como .env y llena tus tokens.
# .env está en .gitignore, no se sube al repo.

# Telegram (para note.sh)
export TOKEN_telegram=
export TOKEN_USER_telegram=

# Memos (para note.sh)
export TOKEN_MEMOS=

# API Keys
export GROQ_API_KEY=
export MINUET_API_KEY=

# Proxy LLM
export CESAR_PROXY_KEY=
export CESAR_LLM_URL="https://llm.guzman-lopez.com/v1"

# Chrome
export CHROME_EXECUTABLE=/usr/bin/google-chrome-stable
